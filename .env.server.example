# Server deployment env. scripts/deploy_server.sh uses .env.server by default.
#
# MVP note:
# OPCV2_ENV defaults to development because production SMS provider is not implemented yet.
# After real SMS is wired, set OPCV2_ENV=production and OPCV2_SMS_PROVIDER to the real provider.

OPCV2_ENV=development
OPCV2_WEB_PORT=8681
OPCV2_POSTGRES_PORT=5433
OPCV2_REDIS_PORT=6391

POSTGRES_DB=opcv2
POSTGRES_USER=opcv2
POSTGRES_PASSWORD=opcv2-change-me

OPCV2_JWT_SECRET=change-me-in-production
OPCV2_SMS_PROVIDER=development
OPCV2_SMS_DEV_CODE=246810

# AI provider. Keep development for MVP smoke tests; use openai for real AI output.
OPCV2_AI_PROVIDER=development
OPCV2_AI_MODEL=development-model
OPCV2_AI_API_KEY=
OPCV2_AI_BASE_URL=
OPCV2_AI_TIMEOUT_SECONDS=30

# Lead providers. Keep development for MVP smoke tests; use tianyancha when API keys are ready.
OPCV2_LEAD_PROVIDER=development
OPCV2_TYC_API_KEY=
OPCV2_TYC_BASE_URL=
OPCV2_TYC_TIMEOUT_SECONDS=10
OPCV2_SERPER_API_KEY=
OPCV2_SERPER_BASE_URL=
OPCV2_SERPER_TIMEOUT_SECONDS=10
OPCV2_SERPAPI_API_KEY=

OPCV2_AUTO_MIGRATE=true
OPCV2_MIGRATIONS_PATH=migrations
OPCV2_CORS_ALLOWED_ORIGINS=http://localhost:8681
OPCV2_EXPENSIVE_ENDPOINT_LIMIT=20
