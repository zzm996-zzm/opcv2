# Server deployment env. scripts/deploy_server.sh uses .env.server by default.
#
# MVP note:
# OPCV2_ENV defaults to development because production SMS provider is not implemented yet.
# After real SMS is wired, set OPCV2_ENV=production and OPCV2_SMS_PROVIDER to the real provider.

OPCV2_ENV=development
OPCV2_WEB_PORT=8681
OPCV2_POSTGRES_PORT=5433
OPCV2_REDIS_PORT=6391

POSTGRES_DB=opcv2
POSTGRES_USER=opcv2
POSTGRES_PASSWORD=opcv2-change-me

OPCV2_JWT_SECRET=change-me-in-production
OPCV2_SMS_PROVIDER=development
OPCV2_SMS_DEV_CODE=246810

# Providers for later phases.
OPCV2_TYC_API_KEY=
OPCV2_SERPER_API_KEY=
OPCV2_SERPAPI_API_KEY=
