# Server deployment env. scripts/deploy_server.sh uses .env.server by default.
#
# MVP note:
# OPCV2_ENV defaults to development because production SMS provider is not implemented yet.
# After real SMS is wired, set OPCV2_ENV=production and OPCV2_SMS_PROVIDER to the real provider.

OPCV2_ENV=development
OPCV2_WEB_PORT=8681
OPCV2_POSTGRES_PORT=5433
OPCV2_REDIS_PORT=6391

# China-friendly deployment mirrors. Override with official images/registries if your server has direct access.
OPCV2_POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16-alpine
OPCV2_REDIS_IMAGE=docker.m.daocloud.io/library/redis:7-alpine
OPCV2_GO_BUILDER_IMAGE=docker.m.daocloud.io/library/golang:1.22.3-alpine
OPCV2_RUNTIME_IMAGE=docker.m.daocloud.io/library/alpine:3.20
OPCV2_NODE_BUILDER_IMAGE=docker.m.daocloud.io/library/node:22-alpine
OPCV2_NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
OPCV2_ALPINE_REPOSITORY=https://mirrors.aliyun.com/alpine
OPCV2_GOPROXY=https://goproxy.cn,direct
OPCV2_NPM_REGISTRY=https://registry.npmmirror.com

POSTGRES_DB=opcv2
POSTGRES_USER=opcv2
POSTGRES_PASSWORD=opcv2-change-me

OPCV2_JWT_SECRET=change-me-in-production
OPCV2_SMS_PROVIDER=development
OPCV2_SMS_DEV_CODE=246810

# AI provider. Keep development for MVP smoke tests; use openai for real AI output.
OPCV2_AI_PROVIDER=development
OPCV2_AI_MODEL=development-model
OPCV2_AI_API_KEY=
OPCV2_AI_BASE_URL=
OPCV2_AI_TIMEOUT_SECONDS=30

# Lead providers. Keep development for MVP smoke tests; use tianyancha when API keys are ready.
OPCV2_LEAD_PROVIDER=development
OPCV2_COMPETITOR_SCANNER_PROVIDER=
OPCV2_TYC_API_KEY=
OPCV2_TYC_BASE_URL=
OPCV2_TYC_TIMEOUT_SECONDS=10
OPCV2_SERPER_API_KEY=
OPCV2_SERPER_BASE_URL=
OPCV2_SERPER_TIMEOUT_SECONDS=10
OPCV2_SERPAPI_API_KEY=

OPCV2_AUTO_MIGRATE=true
OPCV2_MIGRATIONS_PATH=migrations
OPCV2_CORS_ALLOWED_ORIGINS=http://localhost:8681
OPCV2_EXPENSIVE_ENDPOINT_LIMIT=20
OPCV2_FEATURE_PAYWALL_ENABLED=false
OPCV2_PROJECT_FILE_PROVIDER=development
OPCV2_PROJECT_FILE_STORAGE_PATH=data/project-match-files
OPCV2_PROJECT_RETRIEVAL_PROVIDER=development
OPCV2_PROJECT_RESEARCH_PROVIDER=development

# Optional frontend build-time API base URL. Leave empty to use the web container's same-origin /api reverse proxy.
VITE_API_BASE_URL=
