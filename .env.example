OPCV2_ENV=development
OPCV2_HTTP_ADDR=:8080
OPCV2_DATABASE_URL=postgres://opcv2:opcv2@postgres:5432/opcv2?sslmode=disable
OPCV2_REDIS_ADDR=redis:6379
OPCV2_JWT_SECRET=development-only-change-me
OPCV2_SMS_PROVIDER=development
OPCV2_SMS_DEV_CODE=246810
# Use OPCV2_AI_PROVIDER=openai with explicit OPCV2_AI_MODEL and OPCV2_AI_API_KEY in production.
OPCV2_AI_PROVIDER=development
OPCV2_AI_MODEL=development-model
OPCV2_AI_API_KEY=
OPCV2_AI_BASE_URL=
OPCV2_AI_TIMEOUT_SECONDS=30
OPCV2_LEAD_PROVIDER=development
OPCV2_TYC_API_KEY=
OPCV2_TYC_BASE_URL=
OPCV2_TYC_TIMEOUT_SECONDS=10
OPCV2_SERPER_API_KEY=
OPCV2_SERPER_BASE_URL=
OPCV2_SERPER_TIMEOUT_SECONDS=10
OPCV2_AUTO_MIGRATE=true
OPCV2_MIGRATIONS_PATH=migrations
OPCV2_CORS_ALLOWED_ORIGINS=http://localhost:5173
OPCV2_EXPENSIVE_ENDPOINT_LIMIT=20

# Optional frontend build-time API base URL. Leave empty to use same-origin /api.
VITE_API_BASE_URL=

POSTGRES_DB=opcv2
POSTGRES_USER=opcv2
POSTGRES_PASSWORD=opcv2

OPCV2_SERPAPI_API_KEY=
